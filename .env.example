# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored — never commit your real token.

# Create a bot with @BotFather in Telegram, it gives you this token.
TELEGRAM_BOT_TOKEN=

# Your personal chat id. Send any message to your bot, then open:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and copy the value of result[0].message.chat.id
TELEGRAM_CHAT_ID=
